# Central stack config. Copy to .env on the monitoring VM.
#
#   cp .env.example .env

# ============================================================================
# THE CLUSTER is defined in cluster.yml, not here.
# ============================================================================
#
# Copy cluster.yml.example to ./cluster/cluster.yml and edit that. It holds
# node ids, hosts, groups and the runtimes each node serves — one file, so
# there is no way for the halves to disagree, and adding a node needs no
# restart of anything.
#
# SPARK_NODES is the superseded fallback. It could only ever express id, host
# and cluster, leaving each node's routers in that node's own .env. It is
# IGNORED whenever cluster.yml lists any node, so setting it on a migrated
# deployment does nothing at all — which looks exactly like an edit that did
# not take. Leave it commented unless you have no cluster.yml.
#
# SPARK_NODES=sparky=192.168.50.61,alpha/spark2=192.168.50.62

# ============================================================================
# Everything below has sensible defaults.
# ============================================================================

# Escape hatch for running the containers as a different uid/gid. Usually you
# do NOT need this — see the chown step in README.md instead, which keeps the
# containers running as their own non-root users.
#
# Only set it if this directory must stay owned by a specific uid for other
# reasons.
# Note it applies to BOTH services, so they'd share a uid.
# PUID=1000
# PGID=1000

# Ports the agent and node_exporter listen on, if you changed them per-node.
AGENT_PORT=9500
NODE_EXPORTER_PORT=9100

# Published to the Forgejo container registry by scripts/publish-images.sh,
# which pushes BOTH a sha tag and :latest.
#
# :latest is the norm. Every publish moves it to the newest build, and the
# stacks set `pull_policy: always`, so a deploy fetches it — without that,
# compose reuses any local copy and a node silently runs a stale image forever.
#
# The floating tag costs nothing in traceability here: BUILD_VERSION bakes the
# git sha into the image, so /health reports the exact commit running
# regardless of what the tag says. Check with:
#
#   curl -s localhost:8080/health | jq '{backend_version, agent_versions}'
#
# PINNING IS THE EXCEPTION, for when you deliberately want to hold or roll back
# a version. publish-images.sh prints the sha to paste here, and keeps the
# newest 5 locally so a rollback usually needs no rebuild:
#
#   BACKEND_IMAGE=<registry>/<owner>/spark-dash-backend:<sha>
#
# Note :latest means configuration no longer records what is deployed — that
# job belongs to sparkdash_agent_build_info, which reports what actually ran.
BACKEND_IMAGE=forgejo.indielab.tech/brian/spark-dash-backend:latest

# How long Prometheus keeps history. Set from measured usage, 2026-08-16.
#
# Observed: ~24 MB/day with one node scraped (60 MB of TSDB after ~2.5 days),
# at a 15s interval across the agent, node-exporter, Prometheus and Alertmanager.
# Most of that is per-node, so three GX10s land around 65 MB/day.
#
#   180d, 3 nodes  ~12 GB
#   365d, 3 nodes  ~24 GB
#
# The VM's disk is 50 GB with ~43 GB free, and Docker images share it. 180d
# leaves comfortable room; 365d would fit but at over half the free space.
#
# Prefer erring long: raising retention later does NOT recover data already
# deleted, so the cost of being too short is permanent and the cost of being
# too long is a disk alert. NodeDiskFillingUp and PrometheusStorageFillingUp
# both now watch this host properly and predict a week ahead.
PROM_RETENTION=180d

# Prometheus and Alertmanager are LAN-reachable. Neither has auth of its own,
# which is fine here because the LAN is the trust boundary: only the dashboard
# on :8080 is published through the Cloudflare tunnel, and these ports never
# leave the network. Set either to 127.0.0.1 to restrict further and reach them
# over an SSH tunnel instead.
PROM_BIND=0.0.0.0
ALERTMANAGER_BIND=0.0.0.0

# Used for links in notifications, so set it to how you'd actually reach it.
ALERTMANAGER_EXTERNAL_URL=http://192.168.50.156:9093

# The dashboard — the only port published through the Cloudflare tunnel.
BACKEND_BIND=0.0.0.0

# Live-view poll cadence, in seconds. Only runs while someone has the
# dashboard open.
LIVE_POLL_INTERVAL_S=2.0

LOG_LEVEL=INFO
