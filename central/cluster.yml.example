# The cluster — nodes, clusters, and what each one serves.
#
#   cp cluster.yml.example cluster/cluster.yml
#
# THIS FILE IS NOT TRACKED IN GIT once copied, the same way `.env` isn't —
# `cluster/` is gitignored. It holds a deployment's live values, and a UI that
# retires a decommissioned endpoint has to be able to write it without holding
# git credentials.
#
# It replaces two things that used to be separate: SPARK_NODES here, and each
# node's own LLAMA_ROUTER_URLS / VLLM_URLS / LLAMA_METRICS_ROUTERS. Those lived
# in different files that didn't know about each other, which is why the
# per-node stack couldn't be identical. Now it can: the agent asks what it
# should poll.
#
# THIS FILE DEFINES THE CLUSTER, not just its runtimes. When it is present and
# non-empty the backend takes the node list from here and SPARK_NODES is
# ignored entirely — including for the Prometheus target files it renders, so
# live view and history cannot disagree about which nodes exist. A missing or
# empty file falls back to SPARK_NODES, which is how a deployment that has not
# migrated keeps working. A file that exists but does not parse is an error:
# the backend keeps the last good node list and logs loudly rather than
# quietly reverting to the old source. An EMPTY file on a running backend is
# treated the same way — a typo was already survivable and a blank line was
# not, which was backwards. Emptying the cluster deliberately needs a restart.
#
# ORDER IS MEANINGFUL: a node's position here is its colour. Slot 1 is the
# first node listed, and that colour identifies it on every card and every
# chart line. **Append new nodes to the end** and nothing already here changes
# colour; insert one in the middle and everything below it shifts, which on a
# dashboard you read by colour is a genuinely disorienting morning.
#
# Grouping by `cluster:` does not affect this — cards are grouped for display,
# colours come from this list. So cluster members need not be adjacent here,
# and moving them together to tidy the file WOULD repaint.

nodes:
  - id: sparky
    # The id becomes the `node` label on every metric. Choose it once and keep
    # it: changing it splits the node's history in two.

    host: 192.168.50.61

    # agent_port: 9500          # defaults, shown for reference
    # node_exporter_port: 9100

    # cluster: alpha    # omit for a standalone node — a cluster of one.
    #
    # A NAME, not a size and not a number. It is rendered as a heading in the
    # dashboard and written as a Prometheus label, so it has to read well on
    # its own — `cluster="3"` in an alert at 2am needs a decoder ring that
    # lives nowhere. Naming it after the count ("pair") is worse still: that
    # becomes a lie the moment a third node joins, and clusters in the wild
    # run to 32 nodes.
    #
    # Any scalar is accepted, so `cluster: 2` works if you prefer numbers.
    # There is NO sentinel for standalone — omit the key. `cluster: 0` is a
    # cluster named "0", not a standalone node.
    #
    # This is not cosmetic. Clustered nodes pool memory for distributed
    # inference, so a model can span the cluster and their combined free space
    # is real capacity. Summing across clusters would report capacity that does
    # not exist.

    runtimes:
      # PORTS, not URLs. The host above is filled in when this is served to the
      # agent, so a node's address appears exactly once — which is what lets
      # the same stack deploy unchanged to every GX10.
      llama_routers:
        - port: 8001
          # Opt-in for per-model metrics (/metrics?model=), which is what
          # provides tokens/sec and KV cache.
          #
          # Costs nothing while a model is working: the agent only scrapes
          # models NVML reports as busy, so an idle model is left alone and its
          # router's sleep timer expires normally. Without that gate the scrape
          # resets the timer on every poll and the model never sleeps —
          # measured on the GX10, 26.4 GiB held indefinitely.
          scrape_metrics: true
        - port: 8108

      # vLLM's /metrics is appended automatically.
      vllm:
        - 8120

      # SGLang, the same shape — it exposes Prometheus natively too, and its
      # /metrics path is appended the same way.
      #
      # ONLY IF THE SERVER WAS STARTED WITH `--enable-metrics`. Without that
      # flag there is no endpoint to scrape, and the instance reports as
      # configured-but-unreachable — correct, and confusing if the missing
      # flag is what you are looking at.
      #
      # sglang:
      #   - 30000

    # Interfaces to EXCLUDE from alerting, by the name the node reports.
    #
    # AN IGNORE LIST, not an allowlist. Everything is watched unless named
    # here, so an interface nobody has configured still alerts — forgetting to
    # maintain this makes the dashboard noisy, never silent, and a newly
    # cabled port is watched from the moment it comes up.
    #
    # What it is for: a port that HAS been up and was then deliberately
    # unplugged. `NetworkLinkDown` already ignores ports that were never in
    # service, but a port cabled as a test and then pulled looks exactly like
    # one that failed, and no amount of history can tell those apart. This is
    # where the intent goes.
    #
    # THE ROCE PORT BEHIND AN INTERFACE IS EXCLUDED WITH IT. One cable carries
    # both, so naming the interface here also quiets `RdmaPortDown` for the
    # paired device — otherwise unplugging a port would simply swap one alert
    # for another.
    #
    # NOT a way to hide an interface: it is still collected, still charted, and
    # still shown in the Network panel, tagged `not monitored`. Only the alert
    # rules read this.
    #
    # Easier to set from the dashboard's settings panel, which lists the
    # interfaces each node is actually reporting as tick boxes and writes this
    # file for you.
    #
    # interfaces:
    #   ignore:
    #     - enP2p1s0f1np1   # 200Gb f1, cabled to the switch and pulled
    #     - enp1s0f1np1

  # When nodes 2 and 3 arrive they are additions here and nothing else — no
  # per-node file to edit, and nothing node-specific in the node stack.
  #
  # - id: spark2
  #   host: 192.168.50.62
  #   cluster: alpha
  #   runtimes:
  #     llama_routers: [{port: 8001}]
  #
  # - id: spark3
  #   host: 192.168.50.63
  #   cluster: alpha
  #   # A node may serve nothing. Listing it with no runtimes still says so
  #   # deliberately, and that beats leftover values in the node's own .env.
