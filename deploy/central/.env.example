# Central stack config. Copy to .env on the monitoring VM.
#
#   cp .env.example .env

# ============================================================================
# THE CLUSTER — the only place nodes are defined.
# ============================================================================
#
# Comma-separated, `node-id=host`. The id becomes the `node` label on every
# metric, so keep it stable: renaming one orphans that node's history.
#
# GROUPS. Prefix a node with `group/` to mark it as part of a cluster:
#
#   SPARK_NODES=sparky=192.168.50.61,pair/spark2=192.168.50.62,pair/spark3=192.168.50.63
#
# Nodes without a prefix stand alone. This is not cosmetic — it's what keeps
# capacity honest. Clustered nodes pool memory for distributed inference, so a
# model can span the group and their combined free space is real. Ungrouped
# nodes can't do that, so summing across them would report capacity that
# doesn't exist and answer "can I load this?" with a yes when it's a no.
#
# The backend renders Prometheus's scrape targets from this list, so adding a
# node is this one line plus `docker compose up -d backend`. Prometheus needs
# no restart — it re-reads targets on its own refresh interval.
#
# Ports are appended automatically (agent 9500, node_exporter 9100). Override
# per node with `gx10-1=192.168.50.61:9600` if one differs.

SPARK_NODES=gx10-1=192.168.50.61

# When nodes 2 and 3 arrive, this becomes the entire change:
# SPARK_NODES=gx10-1=192.168.50.61,gx10-2=192.168.50.62,gx10-3=192.168.50.63

# ============================================================================
# Everything below has sensible defaults.
# ============================================================================

# Where persistent data and generated files live on the host. Bind mounts
# rather than named volumes, so Prometheus's TSDB sits at a visible path you
# can inspect and back up.
DATA_ROOT=/docker/spark-dash-stack-central

# Escape hatch for running the containers as a different uid/gid. Usually you
# do NOT need this — see the chown step in README.md instead, which keeps the
# containers running as their own non-root users.
#
# Only set it if DATA_ROOT must stay owned by a specific uid for other reasons.
# Note it applies to BOTH services, so they'd share a uid.
# PUID=1000
# PGID=1000

# Ports the agent and node_exporter listen on, if you changed them per-node.
AGENT_PORT=9500
NODE_EXPORTER_PORT=9100

# Published to the Forgejo container registry by scripts/publish-images.sh.
# Pin a real tag rather than :latest once you care about knowing what's
# deployed — Dockhand redeploys on git change, not on image change, so :latest
# can drift silently.
BACKEND_IMAGE=forgejo.indielab.tech/brian/spark-dash-backend:latest

# How long Prometheus keeps history. Revisit in Phase 3 from real disk usage.
PROM_RETENTION=30d

# Prometheus and Alertmanager are LAN-reachable. Neither has auth of its own,
# which is fine here because the LAN is the trust boundary: only the dashboard
# on :8080 is published through the Cloudflare tunnel, and these ports never
# leave the network. Set either to 127.0.0.1 to restrict further and reach them
# over an SSH tunnel instead.
PROM_BIND=0.0.0.0
ALERTMANAGER_BIND=0.0.0.0

# Used for links in notifications, so set it to how you'd actually reach it.
ALERTMANAGER_EXTERNAL_URL=http://192.168.50.156:9093

# The dashboard — the only port published through the Cloudflare tunnel.
BACKEND_BIND=0.0.0.0

# Live-view poll cadence, in seconds. Only runs while someone has the
# dashboard open.
LIVE_POLL_INTERVAL_S=2.0

LOG_LEVEL=INFO
