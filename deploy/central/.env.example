# Central stack config. Copy to .env on the monitoring VM.
#
#   cp .env.example .env

# ============================================================================
# THE CLUSTER — the only place nodes are defined.
# ============================================================================
#
# Comma-separated, `node-id=host`. The id becomes the `node` label on every
# metric, so keep it stable: renaming one orphans that node's history.
#
# The backend renders Prometheus's scrape targets from this list, so adding a
# node is this one line plus `docker compose up -d backend`. Prometheus needs
# no restart — it re-reads targets on its own refresh interval.
#
# Ports are appended automatically (agent 9500, node_exporter 9100). Override
# per node with `gx10-1=192.168.50.61:9600` if one differs.

SPARK_NODES=gx10-1=192.168.50.61

# When nodes 2 and 3 arrive, this becomes the entire change:
# SPARK_NODES=gx10-1=192.168.50.61,gx10-2=192.168.50.62,gx10-3=192.168.50.63

# ============================================================================
# Everything below has sensible defaults.
# ============================================================================

# Ports the agent and node_exporter listen on, if you changed them per-node.
AGENT_PORT=9500
NODE_EXPORTER_PORT=9100

# Built locally by default (see deploy/central/README.md).
BACKEND_IMAGE=spark-dash-backend:latest

# How long Prometheus keeps history. Revisit in Phase 3 from real disk usage.
PROM_RETENTION=30d

# Prometheus has no auth of its own, so it's bound to localhost. Change to
# 0.0.0.0 only if you want its UI reachable from the LAN directly.
PROM_BIND=127.0.0.1

# The dashboard itself — what cloudflared and LAN browsers point at.
BACKEND_BIND=0.0.0.0

# Live-view poll cadence, in seconds. Only runs while someone has the
# dashboard open.
LIVE_POLL_INTERVAL_S=2.0

LOG_LEVEL=INFO
