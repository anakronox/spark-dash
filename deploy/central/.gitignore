# The live config is deliberately NOT tracked.
#
# It differs per deployment and gets edited on the host, so tracking it makes
# every `git pull` a merge conflict against your running configuration — and
# the same file editable from both a web UI and a shell is a guaranteed drift.
#
# `.env.example` is the template; copy it and edit the copy.
.env

# Backups taken before editing the live config. Worth making, not worth
# committing — and they contain the same secrets `.env` does.
.env.bak-*

# RUNTIME DATA. DATA_ROOT defaults to this same directory, so the containers
# write their state right next to the config that git tracks.
#
# Being untracked was not enough: `git add -A` in the deployed stack would
# stage the entire Prometheus TSDB, and `secrets/` holds the ntfy topic URL
# that is deliberately kept out of git. Ignoring them makes that mistake
# impossible rather than merely unlikely.
prometheus/
alertmanager/
secrets/

# Scrape targets rendered by the backend from SPARK_NODES. Generated, not
# authored — `targets/vllm.yml` is hand-maintained and stays tracked.
targets/agents.yml
targets/node-exporters.yml

# The live cluster definition. Same reasoning as .env: it holds this
# deployment's real values, and the dashboard needs to be able to write it
# without git credentials. `cluster.yml.example` is the template.
cluster.yml
