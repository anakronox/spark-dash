# Copy to .env on each GX10 and set NODE_ID. Everything else is usually the
# same across nodes.
#
#   cp .env.example .env

# The only value that MUST differ per node. Becomes the `node` label on every
# metric, so keep it stable — changing it later orphans that node's history.
NODE_ID=gx10-1

# Built locally on each node by default (see deploy/node/README.md). Point at a
# registry instead if you'd rather build once and pull.
AGENT_IMAGE=spark-dash-agent:latest

# The existing llama.cpp/vLLM Compose network name — find it with
# `docker network ls`. The agent joins it to reach those containers by name.
INFERENCE_NETWORK=inference-net

# llama.cpp router base URLs, comma-separated — a node commonly runs several
# router containers. Leave blank on a node that runs only vLLM. Use container
# service names if on the shared network, e.g.
#   LLAMA_ROUTER_URLS=http://llama-router-a:8080,http://llama-router-b:8081
LLAMA_ROUTER_URLS=

# Routers where per-model metrics may be fetched. LEAVE EMPTY unless you're
# sure: a /metrics?model= request LOADS the model on an autoload router. Model
# names, states and capacity are reported for every router regardless — this
# only controls the extra per-model throughput/KV-cache detail.
# Opt in one router at a time, and never one hosting models large enough to
# exhaust the shared pool.
#   LLAMA_METRICS_ROUTERS=http://192.168.50.61:8001
LLAMA_METRICS_ROUTERS=

# Comma-separated vLLM /metrics endpoints on this node, e.g.
#   VLLM_URLS=http://vllm-70b:8000/metrics,http://vllm-8b:8001/metrics
VLLM_URLS=

LOG_LEVEL=INFO
